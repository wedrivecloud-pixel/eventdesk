# Copy to an ignored .env file. Never commit credentials.
APP_ENV=development
APP_URL=http://localhost:3000
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://eventdesk_runtime:CHANGE_ME@localhost:5432/eventdesk
DIRECT_DATABASE_URL=postgresql://eventdesk_owner:CHANGE_ME@localhost:5432/eventdesk
BETTER_AUTH_SECRET=
WASABI_ENDPOINT=https://s3.us-west-1.wasabisys.com
WASABI_REGION=us-west-1
WASABI_BUCKET=
WASABI_ACCESS_KEY_ID=
WASABI_SECRET_ACCESS_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# After Cloudflare is configured, set cloudflare and a random secret injected by its edge rule.
PROXY_MODE=direct
EDGE_SHARED_SECRET=
GOOGLE_PLACES_API_KEY=
